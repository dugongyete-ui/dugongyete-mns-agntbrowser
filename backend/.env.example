# ═════════════════════════════════════════════════════════════════════════
# Dzeck AI Agent — contoh konfigurasi environment (backend/.env)
# Salin ke backend/.env lalu sesuaikan. JANGAN pernah commit .env asli.
# ═════════════════════════════════════════════════════════════════════════

# ── Agent provider (abstraksi model, backward-compatible) ────────────────
# "existing" → gateway OpenAI-compatible yang sudah dikonfigurasi di bawah
#              (DEFAULT, perilaku lama). Di deployment ini gateway-nya adalah
#              NVIDIA NIM: API_BASE=https://integrate.api.nvidia.com/v1 +
#              MODEL_NAME=nvidia/... — model yang sudah dipakai sekarang.
# Nilai tidak dikenal otomatis jatuh kembali ke "existing". "opencode_adapter"
# adalah adaptasi native di runtime Python: bukan CLI/sidecar OpenCode.
AGENT_PROVIDER=existing
# build = perubahan diizinkan setelah gate/confirmation; plan = read-only.
AGENT_MODE=build

# ── Model provider existing (gateway OpenAI-compatible → NVIDIA NIM) ─────
API_KEY=
API_BASE=
MODEL_NAME=gpt-4o
MODEL_PROVIDER=openai
TEMPERATURE=0.7
MAX_TOKENS=2000
#FALLBACK_API_BASE=
#FALLBACK_API_KEY=
#FALLBACK_MODEL_NAME=

# ── Sandbox ──────────────────────────────────────────────────────────────
# auto | replit | local | e2b — di host Replit, E2B tidak pernah disentuh
# (host guard). Di z.ai gunakan "local".
SANDBOX_PROVIDER=local
USER_HOME_ROOT=/home/z/users
SANDBOX_PROTECTED_PATHS=/home/z/my-project

# ── MCP ──────────────────────────────────────────────────────────────────
# Path config MCP user. Bila file TIDAK ada, bootstrap runtime otomatis
# men-generate-nya per lingkungan (Replit / E2B runtime / z.ai) dengan
# server built-in dzeck-fs. File yang sudah ada selalu diutamakan.
MCP_CONFIG_PATH=/home/z/my-project/manusletgo123/mcp.json

# ── Infrastruktur ────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=dzeck
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Mesin orkestrasi & guard agent ───────────────────────────────────────
# langgraph | custom
AGENT_FLOW_ENGINE=langgraph
# compact = focused runtime prompt + request-specific skill routing
# legacy = previous all-in-one prompt profile (rollback)
AGENT_PROMPT_PROFILE=compact
# 0 = tanpa batas iterasi (default)
MAX_STEPS=0
MAX_CONSECUTIVE_FAILURES=10
MANUS_REGISTRY_ENABLED=true

# ── Blok deployment z.ai (tambahan; isi nilai asli secara lokal di .env) ──
# Search
SEARCH_PROVIDER=tavily
SEARCH_FALLBACK_PROVIDER=bing_rss
TAVILY_API_KEY=tvly-xxx

# Auth / JWT
AUTH_PROVIDER=password
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_SECRET_KEY=ganti-dengan-secret-acak

# Vision & summary (NVIDIA NIM)
VISION_MODEL_NAME=meta/llama-3.2-11b-vision-instruct
VISION_MODEL_PROVIDER=openai
VISION_API_BASE=https://integrate.api.nvidia.com/v1
VISION_API_KEY=nvapi-xxx
SUMMARY_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b

# Sandbox browser lokal (Xvfb + Chrome CDP + x11vnc + websockify)
SANDBOX_BASE_URL=http://localhost:8080
SANDBOX_VNC_URL=ws://localhost:5901
SANDBOX_CDP_URL=http://localhost:8222
SANDBOX_DISPLAY_SIZE=1280x1029

# Alias runtime contract (validasi environment.template.json)
LLM_API_KEY=nvapi-xxx
AGENT_DATABASE_URL=mongodb+srv://user:password@cluster/backup?retryWrites=true&w=majority

LOG_LEVEL=INFO
SSL_VERIFY=false
